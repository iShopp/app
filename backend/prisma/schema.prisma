// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  AFFILIATE
}

enum Marketplace {
  TEMU
  ALIEXPRESS
  AMAZON
  EBAY
  LAZADA
  MANUAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum BannerPosition {
  HERO
  SIDEBAR
  BANNER
  POPUP
}

enum PricingRuleType {
  PERCENTAGE_MARKUP
  FIXED_MARKUP
  FIXED_PRICE
}

enum PricingRuleAppliesTo {
  ALL
  CATEGORY
  BRAND
}

enum AutomationJobType {
  PRICE_SYNC
  STOCK_SYNC
  ORDER_FULFILLMENT
  PRODUCT_IMPORT
  IMAGE_OPTIMIZATION
}

enum AutomationJobStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

enum SuggestionType {
  FEATURE
  PRODUCT
  PRICING
  MARKETING
  SEO
}

enum SuggestionPriority {
  LOW
  MEDIUM
  HIGH
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      UserRole @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  affiliate Affiliate?
  reviews             Review[]
  wishlist            Wishlist?
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  emailVerification   EmailVerification?
  notifications       Notification[]
}

model Address {
  id          String  @id @default(cuid())
  label       String  @default("Home")
  firstName   String
  lastName    String
  street      String
  city        String
  state       String
  zip         String
  country     String  @default("US")
  isDefault   Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]
}

model Category {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  image        String?
  icon         String?
  productCount Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products     Product[]
  pricingRules PricingRule[]
}

model Brand {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  logo         String?
  description  String?
  website      String?
  productCount Int     @default(0)
  featured     Boolean @default(false)

  products     Product[]
  pricingRules PricingRule[]
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  description     String?
  price           Float
  originalPrice   Float?
  discount        Float?
  images          String[]
  rating          Float       @default(0)
  reviewCount     Int         @default(0)
  inStock         Boolean     @default(true)
  stockCount      Int         @default(0)
  marketplace     Marketplace @default(MANUAL)
  marketplaceUrl  String?
  marketplaceId   String?
  sku             String?     @unique
  weight          Float?
  tags            String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  variants    ProductVariant[]
  faqs        ProductFAQ[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]
}

model ProductVariant {
  id       String @id @default(cuid())
  name     String
  value    String
  price    Float?
  stock    Int    @default(0)
  imageUrl String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFAQ {
  id       String @id @default(cuid())
  question String
  answer   String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  status         OrderStatus   @default(PENDING)
  subtotal       Float
  shipping       Float         @default(0)
  tax            Float         @default(0)
  discount       Float         @default(0)
  total          Float
  paymentMethod  String?
  paymentStatus  PaymentStatus @default(PENDING)
  trackingNumber String?
  couponCode     String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])

  items    OrderItem[]
  timeline OrderTimelineEvent[]
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  price     Float
  total     Float
  variantId String?

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model OrderTimelineEvent {
  id          String   @id @default(cuid())
  status      String
  description String?
  createdAt   DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Affiliate {
  id               String  @id @default(cuid())
  code             String  @unique
  commissionRate   Float   @default(0.05)
  totalEarnings    Float   @default(0)
  pendingEarnings  Float   @default(0)
  paidEarnings     Float   @default(0)
  conversions      Int     @default(0)
  clicks           Int     @default(0)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String    @unique
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  links AffiliateLink[]
  payoutRequests PayoutRequest[]
}

model AffiliateLink {
  id          String   @id @default(cuid())
  url         String
  destination String
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType @default(PERCENTAGE)
  value       Float
  minPurchase Float?
  maxUses     Int?
  usedCount   Int        @default(0)
  validFrom   DateTime   @default(now())
  validUntil  DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Banner {
  id       String         @id @default(cuid())
  title    String
  subtitle String?
  image    String
  link     String?
  position BannerPosition @default(BANNER)
  isActive Boolean        @default(true)
  order    Int            @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model PricingRule {
  id         String               @id @default(cuid())
  name       String
  marketplace Marketplace?
  type       PricingRuleType      @default(PERCENTAGE_MARKUP)
  value      Float
  appliesTo  PricingRuleAppliesTo @default(ALL)
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])
}

model AutomationJob {
  id        String              @id @default(cuid())
  name      String
  type      AutomationJobType
  status    AutomationJobStatus @default(IDLE)
  schedule  String?
  lastRun   DateTime?
  nextRun   DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model BuilderSuggestion {
  id          String             @id @default(cuid())
  type        SuggestionType
  title       String
  description String
  priority    SuggestionPriority @default(MEDIUM)
  status      SuggestionStatus   @default(PENDING)
  aiGenerated Boolean            @default(false)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model MarketplaceIntegration {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  isConnected  Boolean     @default(false)
  lastSync     DateTime?
  productCount Int         @default(0)
  settings     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  comment   String
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Wishlist {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  addedAt    DateTime @default(now())

  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id          String    @id @default(cuid())
  amount      Float
  status      String    @default("pending")
  method      String    @default("bank")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String   @db.Text
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

